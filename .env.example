# Copie este arquivo para .env e ajuste. O .env NUNCA vai para o GitHub.

# Gere uma chave nova para produção (veja o README)
DJANGO_SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
DJANGO_DEBUG=1

# No PC: localhost. Na VPS: seu domínio (ex.: oficina.duckdns.org)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DOMINIO=localhost

POSTGRES_DB=oficina
POSTGRES_USER=oficina
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

EMPRESA_NOME=Brasil Centro Automotivo

# Backup (opcional, só na VPS)
# Destino do rclone, ex.: gdrive:backups-oficina   (deixe vazio para guardar só na VPS)
RCLONE_DESTINO=
# URL do healthchecks.io para avisar se o backup falhar (opcional)
BACKUP_ALERTA_URL=
